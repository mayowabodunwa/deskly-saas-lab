---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getArticles } from "../../lib/content";

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---

<Base title={article.data.title} description={article.data.description}>
  <article class="prose">
    <p class="eyebrow">
      {article.data.pubDate.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}
      {article.data.draft && <span class="badge">Draft</span>}
    </p>
    <h1>{article.data.title}</h1>
    <Content />
  </article>
</Base>
