---
import Base from "../../layouts/Base.astro";
import { getArticles } from "../../lib/content";

const articles = await getArticles();
---

<Base title="Articles" description="Standalone articles.">
  <h1>Articles</h1>
  {articles.length === 0
    ? <p class="muted">No articles yet. Add a Markdown file to <code>content/articles/</code>.</p>
    : (
      <ul class="card-list">
        {articles.map((a) => (
          <li>
            <a href={`/articles/${a.id}/`}>{a.data.title}</a>
            <p class="muted">{a.data.description}</p>
          </li>
        ))}
      </ul>
    )}
</Base>
