---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { getCollection } from "astro:content";

// Drafts show while developing and are left out of real builds, matching
// how Starlight itself treats `draft: true` pages.
const lessons = (await getCollection("docs", ({ data }) => import.meta.env.DEV || !data.draft))
  .filter((entry) => entry.id.startsWith("course/"))
  .sort((a, b) => (a.data.lesson ?? 0) - (b.data.lesson ?? 0));
const first = lessons[0];
---

<StarlightPage
  frontmatter={{
    title: "Support Engineering by Building Systems",
    description: "Learn how software systems work by building one, breaking it on purpose, and diagnosing it the way a real ticket arrives.",
    template: "splash",
    hero: {
      tagline:
        "Learn how software systems actually work by building one, breaking it on purpose, and diagnosing it the way a real ticket arrives.",
      actions: first
        ? [{ text: "Start the course", link: `/${first.id}/`, icon: "right-arrow", variant: "primary" }]
        : [],
    },
  }}
>
  <h2>How every lesson works</h2>
  <ol>
    <li><strong>A real support ticket</strong> opens the lesson: vague, worried, missing detail.</li>
    <li><strong>Build</strong> the part of the system that ticket is about, on your own laptop.</li>
    <li><strong>Break it on purpose</strong> and work out what went wrong from what you can see.</li>
    <li><strong>Practise</strong>: quizzes and a ticket simulator, then a checklist for next time.</li>
  </ol>

  <h2>Lessons</h2>
  <p class="progress-summary" data-total={lessons.length} hidden></p>
  <ol class="lesson-list">
    {lessons.map((lesson) => (
      <li data-lesson={lesson.id}>
        <a href={`/${lesson.id}/`}>
          <span class="lesson-number">Lesson {lesson.data.lesson}</span>
          <span class="lesson-title">{lesson.data.title.replace(/^Lesson \d+:\s*/, "")}</span>
          <span class="lesson-ticket">“{lesson.data.ticket}”</span>
        </a>
        <span class="lesson-status">
          {lesson.data.draft && <span class="badge">Draft</span>}
          <span class="badge done-badge" hidden>✓ Done</span>
        </span>
      </li>
    ))}
  </ol>
</StarlightPage>

<script>
  import { load } from "../lib/progress";
  const progress = load();
  let done = 0;
  for (const item of document.querySelectorAll<HTMLElement>("[data-lesson]")) {
    if (progress.lessons[item.dataset.lesson!]) {
      item.querySelector<HTMLElement>(".done-badge")!.hidden = false;
      done++;
    }
  }
  const summary = document.querySelector<HTMLElement>(".progress-summary")!;
  summary.textContent = `You've completed ${done} of ${summary.dataset.total} lessons.`;
  summary.hidden = done === 0;
</script>
